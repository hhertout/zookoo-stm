// Alloy configuration for OpenTelemetry metrics
// Receives OTLP metrics from zookoo and forwards to Prometheus

// OTLP gRPC receiver
otelcol.receiver.otlp "zookoo_otlp" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
  }
}

// Batch processor for efficient metric handling
otelcol.processor.batch "default" {
  timeout          = "10s"
  send_batch_size  = 1024

  output {
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

// Export to Prometheus remote_write
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.prom.receiver]
}

// Forward to Prometheus backend
prometheus.remote_write "prom" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
    
    queue_config {
      capacity             = 10000
      max_shards           = 10
      max_samples_per_send = 5000
    }
  }
}
